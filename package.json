{
  "name": "cinepulse",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint && pnpm lint:jsx-spread",
    "lint:jsx-spread": "node scripts/check-jsx-spread.js",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "turbo typecheck",
    "sync-types": "turbo sync-types",
    "prepare": "husky",
    "merge-dist": "node scripts/merge-dist.js",
    "build:deploy": "turbo build --filter=!@repo/design && pnpm merge-dist",
    "emulators": "pnpm build:deploy && firebase emulators:start --project demo --only hosting,functions,auth",
    "deploy": "pnpm build:deploy && firebase deploy --only hosting:production",
    "size": "size-limit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --project demo --only firestore \"vitest run --config firestore/vitest.config.ts\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^11.2.0",
    "@vitest/coverage-v8": "catalog:",
    "firebase": "catalog:",
    "husky": "^9.1.7",
    "jsdom": "catalog:",
    "lint-staged": "^15.2.11",
    "size-limit": "^11.2.0",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js@~1.9.0": "^1.14.5",
      "adm-zip@<0.6.1": "^0.6.1",
      "koa@2.15.4": "^3.2.1",
      "ws@8.18.0": "^8.22.0",
      "koa@3.0.3": "^3.1.2"
    }
  }
}
