{
  "name": "cinepulse",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint && pnpm lint:jsx-spread",
    "lint:jsx-spread": "node scripts/check-jsx-spread.js",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "turbo typecheck",
    "sync-types": "turbo sync-types",
    "prepare": "husky",
    "merge-dist": "node scripts/merge-dist.js",
    "build:deploy": "turbo build --filter=!@repo/design && pnpm merge-dist",
    "emulators": "pnpm build:deploy && firebase emulators:start --project demo --only hosting,functions",
    "deploy": "pnpm build:deploy && firebase deploy --only hosting:production",
    "size": "size-limit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^11.2.0",
    "@vitest/coverage-v8": "catalog:",
    "husky": "^9.1.7",
    "jsdom": "catalog:",
    "lint-staged": "^15.2.11",
    "size-limit": "^11.2.0",
    "turbo": "^2.3.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
